<span class="stars" role="img" aria-label="@Label">
    @for (var i = 1; i <= 5; i++)
    {
        <span class="@(i <= Filled ? "stars__on" : "stars__off")">@Icons.Star</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public double Value { get; set; }

    private int Filled => (int)Math.Round(Math.Clamp(Value, 0, 5), MidpointRounding.AwayFromZero);

    private string Label => $"{Format.NilaiRingkas(Value)} dari 5";
}
