@using System.Linq.Expressions
<div class="input-reveal">
    <InputText id="@Id" type="@(show ? "text" : "password")" autocomplete="@Autocomplete"
               Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" />
    <button type="button" class="input-reveal__btn" tabindex="-1"
            @onclick="() => show = !show" aria-pressed="@show" title="@Judul" aria-label="@Judul">
        @(show ? Icons.EyeOff : Icons.Eye)
    </button>
</div>
@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }
    private bool show;
    private string Judul => show ? "Sembunyikan kata sandi" : "Tampilkan kata sandi";
}
