@using System.ComponentModel.DataAnnotations
@inject SewaApi Api

@if (selesai)
{
    <div class="acct__done">
        <span class="editor__saved">@Icons.Shield Kata sandi berhasil diganti</span>
        <p>Sesi di perangkat lain sudah diakhiri.</p>
    </div>
}
else
{
    <EditForm Model="form" OnValidSubmit="Save" class="acct__form">
        <DataAnnotationsValidator />

        @if (error is not null)
        {
            <div class="form__alert" role="alert">@error</div>
        }

        <div class="acct__row">
            <label class="acct__label" for="lama">Kata sandi saat ini</label>
            <div class="acct__value">
                <PasswordField Id="lama" @bind-Value="form.CurrentPassword"
                               Autocomplete="current-password" />
                <ValidationMessage For="() => form.CurrentPassword" />
            </div>
        </div>

        <div class="acct__row">
            <label class="acct__label" for="baru">Kata sandi baru</label>
            <div class="acct__value">
                <PasswordField Id="baru" @bind-Value="form.NewPassword"
                               Autocomplete="new-password" />
                <p class="acct__hint">@PasswordPolicy.Aturan</p>
                <ValidationMessage For="() => form.NewPassword" />
            </div>
        </div>

        <div class="acct__row">
            <label class="acct__label" for="ulang">Ulangi kata sandi baru</label>
            <div class="acct__value">
                <PasswordField Id="ulang" @bind-Value="form.Confirm"
                               Autocomplete="new-password" />
                <ValidationMessage For="() => form.Confirm" />
            </div>
        </div>

        <div class="acct__row">
            <span class="acct__label"></span>
            <div class="acct__value acct__value--actions">
                <button type="submit" class="btn btn--primary" disabled="@saving">
                    @(saving ? "Menyimpan…" : "Simpan")
                </button>
                <a class="btn btn--outline" href="/lupa-sandi">Lupa kata sandi saat ini</a>
            </div>
        </div>
    </EditForm>
}

@code {
    private bool saving;
    private bool selesai;
    private string? error;
    private SandiForm form = new();

    private sealed class SandiForm
    {
        [Required(ErrorMessage = "Kata sandi saat ini wajib diisi.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Kata sandi baru wajib diisi.")]
        [StrongPassword]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ulangi kata sandi baru.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Kedua kata sandi harus sama.")]
        public string Confirm { get; set; } = string.Empty;
    }

    private async Task Save()
    {
        saving = true;
        error = null;

        error = await Api.ChangePasswordAsync(new ChangePasswordRequest
        {
            CurrentPassword = form.CurrentPassword,
            NewPassword     = form.NewPassword
        });

        if (error is null)
        {
            selesai = true;
            form = new SandiForm();
        }

        saving = false;
    }
}
